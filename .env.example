# Copier ce fichier en .env et le remplir. Ne jamais versionner le .env.

# --- Discord (obligatoires) ---
APP_ID=
GUILD_ID=
DISCORD_TOKEN=
PUBLIC_KEY=

# Salon où sont postés les messages de bienvenue
HOME_CHANNEL=

# Adresse publique du bot, pour les images de /flip (ex : https://discord.commandokieffer.com)
CK_DISCORD_ROOT=

# PORT=3000
# LOG_LEVEL=info  (debug, info, warn, error)

# --- Rôles Discord ---
EM_ROLE=
QM1_ROLE=
QM2_ROLE=
CADET_ROLE=
INSTRUCTEUR_ROLE=
RECRUTEUR_ROLE=
MEMBRE_EQUIPAGE_ROLE=
CIVIL_ROLE=
CIVIL_EN_ATTENTE_ROLE=
ANCIEN_COMMANDO_ROLE=
RECRUITING_ROLE=
# RECRUE_ROLE=1318565126516772985  (valeur par défaut)
T1_ROLE=
T1_B1_ROLE=
T1_B2_ROLE=
T8_ROLE=
T8_B1_ROLE=
T8_B2_ROLE=
T9_ROLE=
T9_B1_ROLE=
T9_B2_ROLE=
TQG_ROLE=
TQG_B1_ROLE=
TQG_B2_ROLE=

# --- Groupes du forum (xf_user_group.user_group_id) ---
T1_ROLE_FORUM=38
T8_ROLE_FORUM=39
T9_ROLE_FORUM=40
TQG_ROLE_FORUM=41
B1_ROLE_FORUM=52
B2_ROLE_FORUM=53
CADET_ROLE_FORUM=5
CIVIL_ROLE_FORUM=2
MEMBRE_EQUIPAGE_ROLE_FORUM=42
SPE_FSL_ROLE_FORUM=30

# --- Base de données du forum ---
# DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWD=

# --- API REST du forum (XenForo) ---
# https obligatoire, sauf pour le forum de test local (http://forum.commandokieffer.ch/index.php/api)
CK_FORUM_API=https://forum.commandokieffer.com/index.php/api
# Clé super-utilisateur avec les droits user:write et thread:write
CK_FORUM_API_KEY=
# Compte forum (administrateur) au nom duquel les comptes sont modifiés
# CK_FORUM_API_USER=8  (valeur par défaut : compte « Commando Kieffer »)
